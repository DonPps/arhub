// firestore.rules — Atlas Rising / Atlas Quiz
//
// À coller dans Firebase Console → Firestore Database → Règles.
// Ce fichier n'est PAS déployé automatiquement (aucun accès au projet
// Firebase depuis cette session) — copie-colle son contenu manuellement.
//
// Principe : chaque utilisateur connecté ne peut lire et écrire QUE le
// document de progression qui porte son propre uid — jamais celui d'un
// autre utilisateur, et jamais sans être connecté.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /quizProgress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pseudo + bio du profil. Jamais lisible par un autre utilisateur —
    // l'email lui-même n'y est pas stocké (il reste dans Firebase Auth,
    // accessible seulement au propriétaire du compte via le SDK).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Emplacements publicitaires (AdManager). Lecture publique (les
    // pubs doivent s'afficher même pour un visiteur non connecté) ;
    // écriture réservée au propriétaire du site (futur panneau
    // /admin/ads). Les compteurs impressions/clics sont mis à jour
    // côté client (ad-manager.js) même par un visiteur anonyme, donc
    // ce champ précis reste ouvert en écriture publique, MAIS limité à
    // ces deux compteurs uniquement — impossible de modifier le
    // contenu d'une pub sans être le propriétaire.
    match /ads/{adId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ochfy.youssef@gmail.com';
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['impressions', 'clicks']);
    }

    // Duels Atlas Quiz (1v1 temps réel). Le document racine ne contient que
    // les métadonnées immuables du duel (rang, questions, hôte) + le champ
    // guestUid qui se remplit une seule fois quand un adversaire rejoint via
    // le lien d'invitation. Lecture publique (comme "leaderboard") pour
    // alimenter les sections "Duels récents" / "Thèmes populaires" visibles
    // même sans connexion — mêmes infos déjà publiques via le classement
    // (pseudo + score), rien de nouveau exposé. L'écriture reste strictement
    // limitée aux participants (voir plus bas), la sécurité de création/
    // jointure ne repose jamais sur le fait que la lecture soit publique.
    match /quizDuels/{duelId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null && (
        // Rejoindre : uniquement si personne n'a encore rejoint, et
        // uniquement en s'auto-désignant soi-même comme invité —
        // impossible de modifier autre chose (rang, questions, hôte).
        (resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid', 'guestNickname', 'status']))
        ||
        // Clôturer le duel : l'un des deux participants peut inscrire le
        // résultat final une seule fois (pour l'historique), jamais après.
        ((request.auth.uid == resource.data.hostUid || request.auth.uid == resource.data.guestUid)
          && resource.data.status != 'finished'
          && request.resource.data.status == 'finished'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'finalHostScore', 'finalGuestScore', 'winnerUid']))
      );

      // État de jeu propre à chaque joueur (score, progression) — chacun ne
      // peut lire/écrire QUE son propre document, jamais celui de
      // l'adversaire (empêche toute triche sur le score de l'autre).
      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Classement public Atlas Quiz — seul endroit du site où un pseudo est
    // associé publiquement à un score (choix assumé pour cette
    // fonctionnalité). Chacun ne peut écrire QUE son propre document.
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Commentaires d'articles. Lecture publique (visibles même sans
    // connexion) ; création réservée aux utilisateurs connectés, qui ne
    // peuvent créer un commentaire que sous leur propre uid (impossible de
    // usurper un autre auteur) ; texte borné pour éviter l'abus. Jamais de
    // modification a posteriori (immuable) — seule la suppression par
    // l'auteur lui-même est permise.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.articleSlug is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Favoris de la page Matchs (équipes + compétitions) — privé, jamais
    // lisible par un autre utilisateur (contrairement au classement
    // Quiz, un favori n'a aucune raison d'être public).
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---------- Atlas Points (progression + boutique + packs) ----------
    //
    // points/{uid} concentre solde + anti-double-crédit + inventaire dans
    // UN SEUL document : Firestore ne peut pas garantir l'atomicité entre
    // deux documents via les règles seules (seulement via des transactions
    // côté client, qu'une règle par document ne "voit" pas) — regrouper
    // évite qu'un client puisse s'octroyer un pack sans que son prix soit
    // réellement déduit du solde dans la même écriture.
    //
    // Chaque écriture porte un champ `lastAction` (type + clé concernée) —
    // ça évite d'avoir à extraire "le nom de la clé ajoutée" d'un diff de
    // map (peu pratique dans ce langage de règles) : le client déclare son
    // intention, la règle vérifie qu'elle correspond exactement au
    // changement réel.
    //
    // Valeurs de points autorisées : DOIVENT rester synchronisées avec
    // POINTS_VALUES dans static/js/points-config.js (dupliquées ici car
    // les règles ne peuvent pas importer un fichier JS externe).
    match /points/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.balance == 0
        && request.resource.data.credited == {}
        && request.resource.data.ownedPacks == {}
        && request.resource.data.ownedItems == {};

      allow update: if request.auth != null && request.auth.uid == userId && (
        // 1. Gain de points : une seule action créditée à la fois, jamais
        // une déjà créditée (empêche le double-crédit), valeur dans
        // l'ensemble autorisé.
        (
          request.resource.data.lastAction.type == 'earn'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'credited', 'lastAction'])
          && !(request.resource.data.lastAction.key in resource.data.credited)
          && request.resource.data.credited[request.resource.data.lastAction.key] == true
          && request.resource.data.credited.diff(resource.data.credited).addedKeys().size() == 1
          && request.resource.data.credited.diff(resource.data.credited).removedKeys().size() == 0
          && request.resource.data.credited.diff(resource.data.credited).changedKeys().size() == 0
          && (request.resource.data.balance - resource.data.balance) in [2, 5, 8, 10, 15, 20, 25, 50]
        )
        ||
        // 2. Connexion quotidienne / série (streak) — pas de points ici
        // (le gain associé passe séparément par le cas 1).
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginStreak', 'lastLoginDate', 'lastAction'])
        )
        ||
        // 3. Achat boutique (badge/avatar/cadre/cosmétique) — le prix
        // vient TOUJOURS du catalogue public `shop`, jamais de ce que le
        // client prétend payer.
        (
          request.resource.data.lastAction.type == 'buy_item'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'ownedItems', 'lastAction'])
          && !(request.resource.data.lastAction.key in resource.data.ownedItems)
          && request.resource.data.lastAction.key in request.resource.data.ownedItems
          && request.resource.data.ownedItems.diff(resource.data.ownedItems).addedKeys().size() == 1
          && request.resource.data.ownedItems.diff(resource.data.ownedItems).removedKeys().size() == 0
          && request.resource.data.ownedItems.diff(resource.data.ownedItems).changedKeys().size() == 0
          && request.resource.data.balance >= 0
          && resource.data.balance - request.resource.data.balance ==
             get(/databases/$(database)/documents/shop/$(request.resource.data.lastAction.key)).data.price
        )
        ||
        // 4. Achat d'un pack — même principe, prix relu depuis `packs`.
        // lastAction.key = instanceId (généré côté client), packSlug =
        // pack acheté.
        (
          request.resource.data.lastAction.type == 'buy_pack'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'ownedPacks', 'lastAction'])
          && !(request.resource.data.lastAction.key in resource.data.ownedPacks)
          && request.resource.data.ownedPacks[request.resource.data.lastAction.key].packSlug == request.resource.data.lastAction.packSlug
          && request.resource.data.ownedPacks.diff(resource.data.ownedPacks).addedKeys().size() == 1
          && request.resource.data.ownedPacks.diff(resource.data.ownedPacks).removedKeys().size() == 0
          && request.resource.data.ownedPacks.diff(resource.data.ownedPacks).changedKeys().size() == 0
          && request.resource.data.balance >= 0
          && resource.data.balance - request.resource.data.balance ==
             get(/databases/$(database)/documents/packs/$(request.resource.data.lastAction.packSlug)).data.price
        )
        ||
        // 5. Équiper un badge/cadre/avatar déjà possédé — gratuit ; l'UI
        // ne propose que ce qui est possédé, afficher un id non possédé
        // n'a aucun effet néfaste.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['equippedBadge', 'equippedFrame', 'equippedAvatar', 'lastAction'])
        )
      );

      // Résultat d'ouverture d'un pack — un document PAR pack ouvert,
      // jamais modifiable après coup : Firestore refuse une "create" sur
      // un chemin déjà occupé (elle devient une "update", ici toujours
      // interdite) — c'est ce qui garantit qu'un pack ne peut être ouvert
      // qu'une seule fois.
      match /openedPacks/{instanceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && instanceId in get(/databases/$(database)/documents/points/$(userId)).data.ownedPacks
          && request.resource.data.packSlug ==
             get(/databases/$(database)/documents/points/$(userId)).data.ownedPacks[instanceId].packSlug
          && request.resource.data.grantedCards is list
          && request.resource.data.grantedCards.size() ==
             get(/databases/$(database)/documents/packs/$(request.resource.data.packSlug)).data.cardsPerPack
          && request.resource.data.grantedCards.hasOnly(
               get(/databases/$(database)/documents/packs/$(request.resource.data.packSlug)).data.cardPool
             );
        allow update, delete: if false;
      }
    }

    // Catalogue boutique (badges/avatars/cadres/cosmétiques) — lecture
    // publique (les prix doivent s'afficher même sans connexion),
    // écriture réservée au propriétaire du site (même principe que `ads`).
    match /shop/{itemId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ochfy.youssef@gmail.com';
    }

    // Catalogue des packs de cartes — même principe.
    match /packs/{packSlug} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ochfy.youssef@gmail.com';
    }

    // ---------- Dream Team (composition d'un onze avec les cartes possédées) ----------
    //
    // Partageable publiquement (décision utilisateur) — même principe que
    // `leaderboard`. La légitimité de chaque carte placée (possédée par
    // l'utilisateur + poste compatible avec le slot) N'EST PAS vérifiée ici :
    // il faudrait parcourir la sous-collection `points/{uid}/openedPacks`
    // (pas faisable en une seule lecture de règle) et connaître le poste de
    // chaque carte (donnée statique, hors Firestore). Compromis accepté :
    // fonctionnalité cosmétique/sociale, aucun enjeu de points ou d'objets —
    // au pire un visiteur voit un onze "impossible", sans conséquence.
    match /dreamTeams/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.formation is string
        && request.resource.data.slots is map
        && request.resource.data.slots.size() <= 11;
    }

  }
}

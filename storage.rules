// storage.rules — Atlas Rising
//
// À coller dans Firebase Console → Storage → Règles (même principe que
// firestore.rules : ce fichier n'est pas déployé automatiquement, aucun
// accès au projet Firebase depuis cette session).
//
// Un seul usage aujourd'hui : upload d'une nouvelle photo d'article depuis
// la page /admin-cms (remplacement d'image). Écriture réservée au
// propriétaire du site (même email que firestore.rules) ; lecture publique
// nécessaire pour qu'agents/admin_sync_agent.py (côté serveur, sans
// authentification Firebase) puisse télécharger le fichier via son URL une
// fois l'upload terminé.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /cms-uploads/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ochfy.youssef@gmail.com'
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
